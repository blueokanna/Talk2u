# Local model sources and QAIRT build products are reproducible, large artifacts.
/model-sources/
/qairt-build/

# Downloaded SenseVoice QNN release artifacts are verified and installed at runtime.
/model/ASR/*.tar.bz2
/model/ASR/sherpa-onnx-qnn-SM8850-*/

